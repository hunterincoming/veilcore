VITE_NETWORK_ID=mainnet
VITE_LOGGING_LEVEL=warn

# The mainnet contract addresses are NOT set here. A mainnet build reads them from
# api/src/deploy-guard.ts (MAINNET_VEILCORE_ADDRESS, MAINNET_CLAIMS_ADDRESS, both set since
# 8 October 2026) and refuses to build while the main one is empty. The site shows both, and
# the browser sends its own transactions to them (a record key's date stamp, proving a record
# by link, dating a DNA pairing, licenses), with VeilCore's fee service paying the fee: README,
# "What the web app sends to the chain". The fee service and the read-only relay are not set
# here either: the deploy passes them in,
#   VITE_INDEXER_RELAY_URL=<relay>/indexer VEILCORE_MAINNET_SPONSOR=<sponsor> npm run deploy:mainnet
# (docs/ops/deploying.md).
