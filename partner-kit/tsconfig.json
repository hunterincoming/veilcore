{
  "include": ["src/**/*.ts", "test/**/*.ts", "record-check/src/**/*.ts", "record-check/test/**/*.ts", "record-check/e2e/**/*.ts"],
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ESNext", "DOM"],
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "allowJs": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "strict": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  }
}
