{
  "extends": "./tsconfig.json",
  "include": ["examples/**/*.mjs", "scripts/**/*.mjs", "scripts/**/*.ts", "record-check/scripts/**/*.mjs", "record-check/e2e/**/*.mjs"],
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noImplicitAny": false,
    "paths": { "@veilcore/contracts": ["./src/index.ts"] }
  }
}
